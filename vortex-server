const express = require("express");
const { createServer } = require("http");
const WebSocket = require("ws");

const app = express();
const server = createServer(app);
const wss = new WebSocket.Server({
  server,
  path: "/ws"
});

const players = new Map();

app.get("/", (req, res) => {
  res.send("Vortex multiplayer server is online!");
});

function broadcast(data, except = null) {
  const message = JSON.stringify(data);

  for (const player of players.values()) {
    if (player.ws !== except && player.ws.readyState === WebSocket.OPEN) {
      player.ws.send(message);
    }
  }
}

wss.on("connection", ws => {

  const id =
    Math.random().toString(36).slice(2) +
    Date.now().toString(36);

  const player = {
    id,
    name: "VortexPlayer",
    avatar: "😎",
    x: 0,
    y: 0,
    z: 0,
    game: null,
    ws
  };

  players.set(id, player);

  ws.send(JSON.stringify({
    type: "welcome",
    id,
    players: [...players.values()].map(p => ({
      id: p.id,
      name: p.name,
      avatar: p.avatar,
      x: p.x,
      y: p.y,
      z: p.z
    }))
  }));

  broadcast({
    type: "playerJoined",
    player: {
      id,
      name: player.name,
      avatar: player.avatar,
      x: 0,
      y: 0,
      z: 0
    }
  }, ws);

  ws.on("message", raw => {

    let data;

    try {
      data = JSON.parse(raw.toString());
    } catch {
      return;
    }

    switch (data.type) {

      case "profile":
        player.name =
          String(data.name || "VortexPlayer").slice(0, 30);

        player.avatar =
          String(data.avatar || "😎").slice(0, 10);

        broadcast({
          type: "playerUpdated",
          player: {
            id,
            name: player.name,
            avatar: player.avatar
          }
        });
        break;

      case "joinGame":
        player.game = String(data.game || "").slice(0, 100);

        ws.send(JSON.stringify({
          type: "gameJoined",
          game: player.game
        }));

        break;

      case "move":
        player.x = Number(data.x) || 0;
        player.y = Number(data.y) || 0;
        player.z = Number(data.z) || 0;

        broadcast({
          type: "playerMoved",
          id,
          x: player.x,
          y: player.y,
          z: player.z
        }, ws);
        break;

      case "chat":
        broadcast({
          type: "chat",
          id,
          name: player.name,
          message: String(data.message || "").slice(0, 200)
        });
        break;

      case "leaveGame":
        player.game = null;
        break;
    }
  });

  ws.on("close", () => {
    players.delete(id);

    broadcast({
      type: "playerLeft",
      id
    });
  });

  ws.on("error", () => {
    players.delete(id);
  });
});

const PORT = process.env.PORT || 10000;

server.listen(PORT, "0.0.0.0", () => {
  console.log(`Vortex server listening on ${PORT}`);
});
